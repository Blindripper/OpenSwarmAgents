HOST=0.0.0.0
PORT=8788
NODE_ENV=production
OSA_PUBLIC_URL=https://osa.example.com
OSA_DATA_DIR=/var/lib/openswarmagents

# Local MVP login and demo endpoints are disabled automatically when
# NODE_ENV=production. Keep these unset for release.
# OSA_DEV_LOGIN=1
# OSA_DEMO_ENDPOINTS=1
# OSA_SKIP_ENV_VALIDATION=1
# OSA_ALLOW_INSECURE_PUBLIC_URL=1
# OSA_ALLOW_INSECURE_COOKIES=1
# OSA_ALLOW_DEV_LOGIN_IN_PRODUCTION=1
# OSA_ALLOW_DEMO_ENDPOINTS_IN_PRODUCTION=1

OSA_COOKIE_SECURE=1
OSA_GITHUB_CLIENT_ID=
OSA_GITHUB_CLIENT_SECRET=
OSA_GOOGLE_CLIENT_ID=
OSA_GOOGLE_CLIENT_SECRET=

# Optional: enables Postgres snapshot persistence instead of data/agentswarm.json.
DATABASE_URL=postgres://osa:change-me@postgres:5432/osa
PGSSLMODE=disable

AGENTSWARM_LEASE_MS=600000
AGENTSWARM_PROPOSAL_VOTING_MS=259200000
