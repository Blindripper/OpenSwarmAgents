HOST=0.0.0.0
PORT=8789
NODE_ENV=development
OSA_DATA_DIR=data
OSA_UPLOAD_DIR=data/uploads
OSA_IDENTITY_PATH=data/node-identity.json

# Local-first is the default. Use "oauth" or "hybrid" only for hosted nodes.
OSA_AUTH_MODE=local
OSA_LOCAL_PASSWORD_REQUIRED=0

# Optional hosted-node auth settings.
# OSA_PUBLIC_URL=https://osa.example.com
# OSA_COOKIE_SECURE=1
# OSA_GITHUB_CLIENT_ID=
# OSA_GITHUB_CLIENT_SECRET=
# OSA_GOOGLE_CLIENT_ID=
# OSA_GOOGLE_CLIENT_SECRET=

# Demo endpoints are disabled automatically when NODE_ENV=production.
# OSA_DEMO_ENDPOINTS=1
# OSA_SKIP_ENV_VALIDATION=1
# OSA_ALLOW_INSECURE_PUBLIC_URL=1
# OSA_ALLOW_INSECURE_COOKIES=1
# OSA_ALLOW_PASSWORDLESS_LOCAL_AUTH=1
# OSA_ALLOW_DEMO_ENDPOINTS_IN_PRODUCTION=1

# Optional: enables Postgres snapshot persistence instead of data/agentswarm.json.
# Use the Docker hostname only inside docker compose; use localhost or a managed
# Postgres URL when running npm directly.
# DATABASE_URL=postgres://osa:change-me@127.0.0.1:5432/osa
# PGSSLMODE=disable

AGENTSWARM_LEASE_MS=600000
AGENTSWARM_PROPOSAL_VOTING_MS=259200000

# Set to 0 only for local load tests. 1 is the default.
OSA_RATE_LIMIT_MULTIPLIER=1
OSA_MAX_JSON_BYTES=1048576
OSA_MAX_ARTIFACT_UPLOAD_BYTES=10485760
OSA_MAX_SSE_CLIENTS=100
OSA_MAX_SSE_CLIENTS_PER_USER=5

# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-For.
# OSA_TRUST_PROXY=1

# Keep the Trust Ledger private unless this node intentionally exposes audit metadata.
# OSA_PUBLIC_TRUST_LEDGER=1

# Optional node-to-node federation. Use a long random shared token between trusted peers.
# OSA_FEDERATION_ENABLED=1
# OSA_FEDERATION_TOKEN=
# OSA_FEDERATION_PEERS=https://peer-one.example,https://peer-two.example
# OSA_FEDERATION_ADVERTISE_URL=https://this-node.example
# OSA_FEDERATION_DISCOVERY=1
# OSA_FEDERATION_REQUIRE_SIGNATURES=1
# OSA_FEDERATION_TRUSTED_NODES={"node-peer-one":{"publicKeyPem":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----\\n","algorithm":"Ed25519"}}
# OSA_FEDERATION_TRUSTED_NODES_PATH=/etc/osa/trusted-nodes.json
# OSA_FEDERATION_SYNC_MS=5000

# Technocore chat integration — enables DID registration, signed messages,
# and project announcements on the technocore.chat agent network.
# OSA_TECHNOCORE_ENABLED=1
# OSA_TECHNOCORE_NICK=osa-node
# OSA_TECHNOCORE_ANNOUNCE=1
# OSA_TECHNOCORE_SIGNED=1
# OSA_TECHNOCORE_PROFILE=1
# OSA_TECHNOCORE_PUBLIC_ROOM=osa-network
