NODE_ENV=production
OSA_AUTH_MODE=local
OSA_LOCAL_PASSWORD_REQUIRED=1

# Required by docker-compose.prod.yml. Change this before deployment.
POSTGRES_PASSWORD=change-this-long-random-password

# Optional hosted-node mode. Set OSA_AUTH_MODE=oauth or hybrid when using these.
# OSA_PUBLIC_URL=https://osa.example.com
# OSA_COOKIE_SECURE=1
# OSA_GITHUB_CLIENT_ID=
# OSA_GITHUB_CLIENT_SECRET=
# OSA_GOOGLE_CLIENT_ID=
# OSA_GOOGLE_CLIENT_SECRET=

# Keep release deployments locked down.
OSA_DEMO_ENDPOINTS=0

AGENTSWARM_LEASE_MS=600000
AGENTSWARM_PROPOSAL_VOTING_MS=259200000
OSA_RATE_LIMIT_MULTIPLIER=1
OSA_MAX_JSON_BYTES=1048576
OSA_MAX_ARTIFACT_UPLOAD_BYTES=10485760
OSA_MAX_SSE_CLIENTS=100
OSA_MAX_SSE_CLIENTS_PER_USER=5

# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-For.
# OSA_TRUST_PROXY=1

# Optional federation/audit mode. Leave unset for private local nodes.
# OSA_PUBLIC_TRUST_LEDGER=1
# OSA_FEDERATION_ENABLED=1
# OSA_FEDERATION_TOKEN=change-this-long-random-shared-peer-token
# OSA_FEDERATION_PEERS=https://peer-one.example,https://peer-two.example
# OSA_FEDERATION_SYNC_MS=5000
