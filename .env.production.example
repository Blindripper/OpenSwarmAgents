NODE_ENV=production
OSA_PUBLIC_URL=https://osa.example.com
OSA_COOKIE_SECURE=1

# Required by docker-compose.prod.yml. Change this before deployment.
POSTGRES_PASSWORD=change-this-long-random-password

# Configure at least one OAuth provider for production.
OSA_GITHUB_CLIENT_ID=
OSA_GITHUB_CLIENT_SECRET=
OSA_GOOGLE_CLIENT_ID=
OSA_GOOGLE_CLIENT_SECRET=

# Keep release deployments locked down.
OSA_DEV_LOGIN=0
OSA_DEMO_ENDPOINTS=0

AGENTSWARM_LEASE_MS=600000
AGENTSWARM_PROPOSAL_VOTING_MS=259200000
OSA_RATE_LIMIT_MULTIPLIER=1
